# Titan/GoDaddy mail credentials — never commit the real .env file
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
MAIL_USERNAME=core@teamflint.in
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESSES=core@teamflint.in,hello@teamflint.in,contact@teamflint.in

DATABASE_URL=postgresql+psycopg2://flint:flint@localhost:5432/flint_mail

# Comma-separated list of allowed web origins (Nest app, landing site, ...)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_SECRET=change-me

# Inbox that receives the landing-site contact form enquiries
CONTACT_RECIPIENT=teamflint.info@gmail.com
